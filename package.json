{
  "name": "@hornero/design-tokens",
  "version": "0.3.0",
  "description": "Valores del sistema de diseño de UdeSA-X, compartidos por la app mobile y el backoffice web",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./tokens.js",
  "types": "./tokens.d.ts",
  "exports": {
    ".": {
      "types": "./tokens.d.ts",
      "default": "./tokens.js"
    },
    "./tokens.json": "./tokens.json"
  },
  "files": [
    "tokens.js",
    "tokens.d.ts",
    "tokens.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate-tokens.mjs",
    "check": "node scripts/generate-tokens.mjs --check",
    "contrast": "node scripts/check-contrast.mjs",
    "typecheck": "tsc --noEmit --strict tokens.d.ts",
    "test": "npm run check && npm run typecheck && npm run contrast"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hornero-X-Labs/design-tokens.git"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
